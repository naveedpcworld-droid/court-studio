# copy to config.env and paste your own keys
# serper.dev (Google search/images/news, 2500 free)
SERPER_API_KEY=
# pexels.com/api (free stock video)
PEXELS_API_KEY=

# ---- Voiceover (optional — default "edge" is FREE, no key) ----
# VOICE_PROVIDER = edge | ai33 | elevenlabs
VOICE_PROVIDER=edge
# ai33.pro (ElevenLabs voices, cheaper): dashboard -> API keys. Voice id looks like elevenlabs_xxxxxxxx
AI33_KEY=
AI33_VOICE=
# ElevenLabs direct: elevenlabs.io -> Profile -> API keys. Voice id from the Voices page.
ELEVENLABS_KEY=
ELEVENLABS_VOICE=
ELEVENLABS_MODEL=eleven_multilingual_v2
